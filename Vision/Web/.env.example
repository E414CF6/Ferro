# Server-side backend address (loaded by Next.js API routes on server)
BACKEND_URL=http://127.0.0.1:8080

# Next.js Server host/port
PORT=8000
HOSTNAME=0.0.0.0

# Client-facing endpoints (relative paths routed via Next.js API proxy)
NEXT_PUBLIC_GRAPHQL_ENDPOINT=/api/graphql
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_GRAPHQL_WS_ENDPOINT=ws://everest.r-e.kr:8080/graphql/ws
