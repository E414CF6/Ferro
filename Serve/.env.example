# Serve Backend Configuration Template
APP_ENV=development
HOST=127.0.0.1
PORT=8080

# Database Configuration (SQLite default or PostgreSQL)
DATABASE_DRIVER=sqlite
DATABASE_URL=sqlite://serve.db
SQLITE_PATH=./serve.db
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_CONNECT_TIMEOUT_SECS=10
DB_ACQUIRE_TIMEOUT_SECS=15
DB_IDLE_TIMEOUT_SECS=600
DB_AUTO_MIGRATE=true
DB_SEED_DATA=false

# Storage Configuration (local or s3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_BASE_URL=/uploads
# S3_BUCKET=serve-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://cdn.ferro.app
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Authentication & Security
JWT_SECRET=ferro-development-secret-key-do-not-use-in-production-32bytes!
JWT_EXPIRATION_DAYS=30

# Rate Limiting & Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECS=60

# GraphQL & GraphiQL
ENABLE_GRAPHIQL=true
ENABLE_INTROSPECTION=true
GRAPHIQL_PATH=/graphiql
GRAPHQL_PATH=/graphql

# Logging
LOG_FORMAT=pretty
LOG_FILTER=info,serve=debug,tower_http=info,sqlx=warn,async_graphql=info
